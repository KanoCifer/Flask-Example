# 数据库配置
DATABASE_URL='postgresql+asyncpg://user:password@localhost/dbname'
DB_MIGRATE_URL='postgresql+psycopg://user:password@localhost/dbname'

# 邮件配置
MAIL_USERNAME="your-email@example.com"
MAIL_PASSWORD="your-email-password"

# 安全配置
SECRET_KEY='your-secret-key-here'
CSRF_COOKIE_SECURE=False

# 可信反向代理（逗号分隔 IP 或 CIDR），如 Nginx：
# 仅这些来源的 X-Forwarded-For 末段被当作真实客户端 IP。
# 默认仅信任同机反代（loopback）；nginx 在其它网段/容器时需显式补充。
TRUSTED_PROXIES='127.0.0.1,::1'

# MongoDB配置
MONGO_URI="mongodb://localhost:27017/"

# AI API配置
API_KEY="your-ai-api-key"

# DeepSeek API 配置（Learning 模块专用，独立于 AntLLM 的 API_KEY）
# 未配置时 create_deepseek_model() 立即抛 RuntimeError，不影响现有 summary/chat/weather。
DEEPSEEK_API_KEY=""

# Exa API 配置（Learning 模块研究步骤专用，独立于 API_KEY / DEEPSEEK_API_KEY）
# 未配置时 create_research_agent() 立即抛 RuntimeError。Exa 是 web 搜索 API，
# 让 LLM 在编排课程前做主题调研（sub-query、引用、事实/规格/示例）。
EXA_API_KEY=""

# WebAuthn配置
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

# GitHub OAuth配置
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:5555/api/v1/auth/github/callback

# Webhook配置
WEBHOOK_SECRET=your-strong-webhook-secret-here  # Gitee Webhook验证密钥

# Amap地图配置
AMAP_SECURITY_CODE=your-amap-security-code-here

# Redis配置
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10

# 媒体上传配置（Python 端与 Go 端共享）
# 上传文件的存储根目录；绝对路径（如 /home/kano/media）或相对路径均可。
# 默认 ./media（Python 端相对 backend/，Go 端相对 go-backend/）。
# 设成同一绝对路径可使两端共享同一份上传文件。
MEDIA_PATH=./media
# 单文件上传上限（MB），默认 10
MAX_UPLOAD_MB=10
